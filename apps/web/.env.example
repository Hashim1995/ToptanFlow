# Template only. Copy to .env locally; .env is git-ignored (see root .gitignore).
#
# Local Vite (`yarn workspace web dev`) proxies `/api` → http://localhost:3000
# by default, so leave this unset (or comment it out) for same-origin calls.
# Set only when the web app must call the API on another host/port directly.
#
# VITE_API_BASE_URL=http://localhost:3000/api/v1
