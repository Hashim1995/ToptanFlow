// TOPTANFLOW — Domain Prisma schema
//
// Source of truth: docs/business/invariants.md, docs/business/terminology.md,
// docs/business/workflow-map.md (per AGENTS.md Source of Truth Hierarchy).
// No business rule (validation, calculation, permission, or posting behavior)
// is implemented here — only structural fields, relations, keys, and indexes.
// The backend application layer remains authoritative (ADR-003).
//
// Deliberately NOT modeled yet (distinct future tasks):
//   - Sales returns, purchase returns as separate documents
//   - Bundles/components (Bundles and Promotions module)
//   - Field Sales / Yatı trips (EPIC-014 — redesign required under ADR-029;
//     no vehicle warehouses)
//   - Fixed assets (separate from Products; documentation/future)
//   - A full append-only Audit History log entity (docs/business/terminology.md,
//     "Audit (Audit History)") — only per-record audit timestamps/actors are
//     included here where required.
//   - Purchase/Sale Nest posting services (EPIC-009 / EPIC-010) — schema ready;
//     quantity → ProductQuantityHistory; debt → BusinessPartnerDebtMovement
//   - Full NegativeStockCase machinery (BRD-OD-04)
//   - Multi-currency Cash accounts (ADR-031 — future Cash only; YAGNI now)
//
// Product quantity (ADR-029): one currentQuantity per Product + history.
// Partner debt (ADR-030): one signed currentDebtBalance per BusinessPartner +
// auditable BusinessPartnerDebtMovement. Sign: >0 partner owes us; <0 we owe
// partner; =0 none.
//
// Money amounts (ADR-031): static base currency AZN for all current domains.
// No Currency reference model. Currency may return only under future Cash.
// Precision: ADR-023 for annotated decimals.
//
// UUID version/storage representation is not decided by ADR-020 ("Future
// Structure Decisions"). This schema uses Prisma's default `uuid()` (v4) as a
// working default; revisit if a specific UUID version is later approved.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Product type classification, independent of product category.
/// Source: docs/business/invariants.md, "Products" —
/// "Product type (finished good, raw material, or mixed-use) and product
/// category are separate, independent classifications."
enum ProductType {
  FINISHED_GOOD
  RAW_MATERIAL
  MIXED_USE
}

/// Product quantity history kinds (ADR-029). Lives inside Products — not a
/// separate Warehouse or Stock module.
enum ProductQuantityHistoryKind {
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALE_RETURN
  INITIAL_QUANTITY
  MANUAL_ADJUSTMENT
  CANCELLATION_REVERSAL
}

/// Business partner debt movement kinds (ADR-030).
enum BusinessPartnerDebtMovementKind {
  SALE
  SALE_RETURN
  SALE_CANCELLATION
  PURCHASE
  PURCHASE_RETURN
  PURCHASE_CANCELLATION
  CASH_RECEIPT
  CASH_PAYMENT
  MANUAL_ADJUSTMENT
  OPENING_BALANCE
  REVERSAL
}

/// Shared document lifecycle status for transactional documents.
/// Source: docs/business/invariants.md, "Global Invariants" —
/// "Drafts have no inventory, cash, receivable, payable, cost, or profit
/// effect. Posting is the official business event... Posted facts are not
/// deleted or silently edited... a return, cancellation, reversal,
/// reallocation, or an authorized adjustment."
/// A CANCELLED document is retained, never deleted, and its identity/number
/// is never reused (docs/business/invariants.md, "Sales", "Purchasing").
enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// Classification of a money account.
/// Source: docs/business/invariants.md, "Cash" —
/// "The main cash account, bank account, vehicle cash accounts, and personal
/// funds are separate; a movement recorded in one account is never used to
/// silently increase another."
/// TODO: VEHICLE_CASH is included for terminology completeness (docs/business/
/// terminology.md, "Vehicle Cash Account"), but the Field Sales (Yatı) trip
/// structure that would normally own such an account is out of scope for this
/// task and is not modeled here.
enum MoneyAccountType {
  MAIN_CASH
  BANK
  VEHICLE_CASH
  PERSONAL_FUNDS
}

/// Classification of a cash movement's business nature.
/// Source: docs/business/invariants.md, "Cash" — "Every money movement
/// identifies the account, amount, date, movement type, actor, and business
/// reason or source," and the specific movement kinds named throughout that
/// section (opening entry, adjustment, transfer, owner contribution/
/// withdrawal) and "Sales"/"Purchasing" (receipt/payment against a document).
/// TODO: Settlement-layer distinctions (e.g., a receipt applied to a specific
/// document vs. retained as an advance) are not modeled as separate types
/// here, since Allocation/Advance entities are out of this task's scope
/// (docs/business/terminology.md, "Allocation", "Customer Advance",
/// "Supplier Advance").
enum CashTransactionType {
  OPENING_BALANCE
  SALE_RECEIPT
  PURCHASE_PAYMENT
  EXPENSE_PAYMENT
  TRANSFER
  ADJUSTMENT
  OWNER_CONTRIBUTION
  OWNER_WITHDRAWAL
  REFUND
}

// ---------------------------------------------------------------------------
// Internal infrastructure: business code sequences
// ---------------------------------------------------------------------------

/// Internal, database-backed counter for automatic business codes
/// (Product, BusinessPartner). Not exposed via HTTP. Allocation must run
/// inside the same Prisma transaction as entity creation so a failed create
/// rolls back the increment. See ADR-024. Warehouse sequence removed (ADR-029).
model NumberSequence {
  /// Internal sequence key (e.g. PRODUCT, BUSINESS_PARTNER, PURCHASE).
  /// Application constants only — never accepted from HTTP input.
  key          String   @id
  /// Last allocated integer value. Next allocation returns currentValue + 1.
  currentValue BigInt   @default(0)
  /// Minimum decimal digit width for formatting (does not truncate when
  /// exceeded). Default 7 → "0000001".
  padding      Int      @default(7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Identity foundation
// ---------------------------------------------------------------------------

/// Minimal user foundation, required only because Sales, Purchases, and Cash
/// Transactions must be attributable to an identifiable actor.
/// Source: docs/business/invariants.md, "Users & Permissions" —
/// "every sensitive action must remain attributable to one identifiable user
/// account," and "User accounts are personal; when employment ends, the
/// account is deactivated, not deleted."
/// Credentials: `passwordHash` (Argon2id) per ADR-025. No Role/Permission
/// tables in v1 (flat equal active users). JWT login is US-019.
model User {
  id           String   @id @default(uuid())
  fullName     String
  /// Unique login identifier (ADR-025).
  username     String   @unique
  /// Argon2id hash. Never returned by HTTP APIs.
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdSales          Sale[]            @relation("SaleCreatedBy")
  postedSales           Sale[]            @relation("SalePostedBy")
  cancelledSales        Sale[]            @relation("SaleCancelledBy")
  createdPurchases      Purchase[]        @relation("PurchaseCreatedBy")
  postedPurchases       Purchase[]        @relation("PurchasePostedBy")
  cancelledPurchases    Purchase[]        @relation("PurchaseCancelledBy")
  createdCashTxns              CashTransaction[]         @relation("CashTransactionCreatedBy")
  postedCashTxns               CashTransaction[]         @relation("CashTransactionPostedBy")
  cancelledCashTxns            CashTransaction[]         @relation("CashTransactionCancelledBy")
  createdProductQuantityHistory ProductQuantityHistory[] @relation("ProductQuantityHistoryCreatedBy")
  createdPartnerDebtMovements  BusinessPartnerDebtMovement[] @relation("PartnerDebtMovementCreatedBy")
  refreshTokens                RefreshToken[]

  @@index([isActive])
}

/// Server-side refresh token (hashed). Opaque token value is only in the
/// httpOnly cookie; rotation revokes the previous row (ADR-025).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the opaque refresh token.
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Business Partners (Customers & Suppliers)
// ---------------------------------------------------------------------------

/// A single business-partner record that may act as a customer, a supplier,
/// or both at once (ADR-030). One signed AZN debt balance; sales and purchases
/// with the same partner intentionally offset on that balance.
model BusinessPartner {
  id                String   @id @default(uuid())
  name              String
  isCustomer        Boolean  @default(false)
  isSupplier        Boolean  @default(false)
  /// Source: docs/business/invariants.md, "Business Partners" — "Possible
  /// duplicate partners are flagged using normalized name, phone, tax
  /// number, and other identifiers before a new record is created." This is
  /// a soft, flagged check (not a hard rejection), so `taxNumber`/`phone` are
  /// indexed for lookup, not declared unique.
  taxNumber         String?
  phone             String?
  email             String?
  address           String?
  notes             String?
  /// Business partner code is backend-generated (ADR-024), globally unique
  /// including inactive rows, immutable after creation, and never reused.
  code              String   @unique
  /// Signed AZN debt balance (ADR-030). >0 partner owes us; <0 we owe partner;
  /// =0 none. Updated only with a matching BusinessPartnerDebtMovement insert
  /// in the same transaction. Scale: ADR-023 money → Decimal(18, 4).
  currentDebtBalance Decimal @default(0) @db.Decimal(18, 4)
  /// Source: docs/business/invariants.md, "Business Partners" — "A partner
  /// that has been used in transactions is inactivated, not deleted."
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sales            Sale[]
  purchases        Purchase[]
  cashTransactions CashTransaction[]
  debtMovements    BusinessPartnerDebtMovement[]

  @@index([taxNumber])
  @@index([phone])
  @@index([isCustomer])
  @@index([isSupplier])
  @@index([isActive])
  @@index([currentDebtBalance])
}

/// Append-only partner debt movements (ADR-030). `signedAmount` uses the same
/// sign convention as currentDebtBalance changes (positive increases the
/// displayed debt balance toward "partner owes us").
model BusinessPartnerDebtMovement {
  id             String                         @id @default(uuid())
  partnerId      String
  partner        BusinessPartner                @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  kind           BusinessPartnerDebtMovementKind
  signedAmount   Decimal                        @db.Decimal(18, 4)
  balanceBefore  Decimal                        @db.Decimal(18, 4)
  balanceAfter   Decimal                        @db.Decimal(18, 4)
  reason         String?
  saleId         String?
  sale           Sale?                          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  purchaseId     String?
  purchase       Purchase?                      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  cashTransactionId String?
  cashTransaction   CashTransaction?            @relation(fields: [cashTransactionId], references: [id], onDelete: Restrict)
  relatedDocumentType String?
  relatedDocumentId   String?
  reversalOfId   String?
  reversalOf     BusinessPartnerDebtMovement?   @relation("PartnerDebtReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      BusinessPartnerDebtMovement[]  @relation("PartnerDebtReversal")

  createdAt       DateTime @default(now())
  createdByUserId String
  createdBy       User     @relation("PartnerDebtMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([partnerId, createdAt])
  @@index([kind])
  @@index([saleId])
  @@index([purchaseId])
  @@index([cashTransactionId])
  @@index([createdByUserId])
  @@index([reversalOfId])
}

// ---------------------------------------------------------------------------
// Reference data: Units (Currency removed — ADR-031)
// ---------------------------------------------------------------------------

/// A unit of measure. Source: docs/business/invariants.md, "Products" —
/// "Each product has exactly one primary unit of measure; whether fractional
/// quantities are allowed follows that unit's configuration."
model Unit {
  id                       String   @id @default(uuid())
  code                     String   @unique
  name                     String
  allowsFractionalQuantity Boolean  @default(true)
  /// TODO: docs do not explicitly state a deactivation rule for Units (unlike
  /// Products/Partners/Users). `isActive` is added by analogy for referential
  /// consistency with products that reference a unit; confirm with the
  /// Business Analyst if this assumption should be removed or adjusted.
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  products      Product[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
}

// ---------------------------------------------------------------------------
// Products — quantity history (ADR-029)
// ---------------------------------------------------------------------------

/// Append-only product quantity history inside the Products domain.
/// Source: ADR-029; docs/business/invariants.md, "Product Quantity".
/// `quantityChange` is signed (positive = increase, negative = decrease).
/// `quantityBefore` / `quantityAfter` snapshot the product's currentQuantity.
/// No `updatedAt`: rows must not be mutated or deleted in place.
/// Scale: ADR-023 quantities → `Decimal(18, 4)`.
model ProductQuantityHistory {
  id             String                      @id @default(uuid())
  productId      String
  product        Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind           ProductQuantityHistoryKind
  quantityChange Decimal                     @db.Decimal(18, 4)
  quantityBefore Decimal                     @db.Decimal(18, 4)
  quantityAfter  Decimal                     @db.Decimal(18, 4)
  /// Mandatory for MANUAL_ADJUSTMENT and for any change that leaves quantity
  /// negative (ADR-029). Nullable for ordinary purchase/sale posts.
  reason         String?
  saleId         String?
  sale           Sale?                       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  purchaseId     String?
  purchase       Purchase?                   @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  /// Optional polymorphic link for returns / other documents not yet modeled.
  relatedDocumentType String?
  relatedDocumentId   String?

  createdAt       DateTime @default(now())
  createdByUserId String
  createdBy       User     @relation("ProductQuantityHistoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([kind])
  @@index([saleId])
  @@index([purchaseId])
  @@index([createdByUserId])
  @@index([relatedDocumentType, relatedDocumentId])
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

/// Flat product category reference data (CHANGE-001 / US-042).
/// Product type and category remain separate classifications
/// (docs/business/invariants.md, "Products").
/// Historical category-on-document reporting (BRD-CA-18) is NOT modeled here.
model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
}

/// Source: docs/business/invariants.md, "Products"; ADR-029 product quantity.
///
/// Persistence notes:
/// - Code is backend-generated via NumberSequence (ADR-024); uniqueness is
///   global (including inactive rows); soft-delete via `isActive` only —
///   never physical delete [Approved Human Decision, recorded 2026-07-28].
/// - Decimal scales follow ADR-023 (unit prices / quantity thresholds:
///   `NUMERIC(18, 4)`). Current quantity lives on this row and must reconcile
///   to SUM(ProductQuantityHistory.quantityChange) (ADR-029).
/// - No Product-owned currency: master prices are informational defaults in
///   the system’s static AZN context (ADR-031). Sale/Purchase amounts are AZN
///   with no currency relation.
/// - Fixed Assets are never modeled as Product rows (ADR-029).
model Product {
  id                     String           @id @default(uuid())
  /// Product business code is backend-generated (ADR-024), globally unique
  /// including inactive rows, immutable after creation, and never reused.
  /// Application-layer clients must not supply this value.
  code                   String           @unique
  name                   String
  type                   ProductType
  /// Optional FK to flat ProductCategory (CHANGE-001). Nullable — products
  /// may exist without a category. Inactive categories remain readable for
  /// historical products; create/update must use an active category.
  categoryId             String?
  category               ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitId                 String
  /// Required primary unit of measure. `onDelete: Restrict` so a Unit
  /// cannot be removed while Products reference it. Referencing an
  /// *inactive* Unit remains allowed at the DB layer so historical
  /// products stay intact; blocking inactive Units on *new* product
  /// create/update is application policy.
  unit                   Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// "Standard sale price and latest purchase price are informational
  /// defaults only; each posted document line keeps its own price and cost
  /// as recorded at posting time, regardless of later master-data changes."
  /// Scale: ADR-023 unit prices → `Decimal(18, 4)` / PostgreSQL `NUMERIC(18, 4)`.
  standardSalePrice      Decimal?         @db.Decimal(18, 4)
  /// Scale: ADR-023 unit prices → `Decimal(18, 4)` / PostgreSQL `NUMERIC(18, 4)`.
  latestPurchasePrice    Decimal?         @db.Decimal(18, 4)
  /// Company-wide current quantity (ADR-029). Default 0. Updated only with
  /// a matching ProductQuantityHistory insert in the same transaction.
  /// Scale: ADR-023 → `Decimal(18, 4)`.
  currentQuantity        Decimal          @default(0) @db.Decimal(18, 4)
  /// Optional minimum quantity alert threshold (company-wide). Scale ADR-023.
  criticalStockThreshold Decimal?         @db.Decimal(18, 4)
  barcode                String?
  notes                  String?
  isActive               Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  saleItems              SaleItem[]
  purchaseItems          PurchaseItem[]
  quantityHistory        ProductQuantityHistory[]

  @@index([unitId])
  @@index([categoryId])
  @@index([type])
  @@index([isActive])
  @@index([barcode])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

/// Source: docs/business/invariants.md, "Sales"; docs/business/workflow-map.md,
/// "1. Sale: Draft to Posted Sale".
model Sale {
  id                    String          @id @default(uuid())
  /// A human-facing sale document number, globally unique across all
  /// history. [Approved Human Decision, recorded 2026-07-28.] Source:
  /// docs/business/invariants.md, "Global Invariants" — "a cancelled
  /// document's number is never reused"; a hard, permanent `@unique`
  /// constraint enforces this, consistent with `Sale` rows never being
  /// physically deleted (only cancelled).
  documentNumber        String          @unique
  partnerId             String
  partner               BusinessPartner @relation(fields: [partnerId], references: [id])
  /// The date the sale is considered to have occurred for business purposes,
  /// distinct from `createdAt` (when it was recorded in the system).
  /// Source: docs/business/terminology.md, "Business Date".
  businessDate          DateTime
  status                DocumentStatus  @default(DRAFT)

  /// Amounts are static AZN (ADR-031). Scale follows ADR-023 when refined.
  totalAmount    Decimal
  discountAmount Decimal?
  /// Open debt effect of a posted sale is applied to BusinessPartner
  /// currentDebtBalance (ADR-030), not stored as a separate receivable field.
  notes          String?

  postedAt       DateTime?
  postedByUserId String?
  postedBy       User?     @relation("SalePostedBy", fields: [postedByUserId], references: [id])

  /// Cancelling a posted sale reverses product-quantity and partner-debt
  /// effects via auditable reversing rows (ADR-029 / ADR-030). Linked cash
  /// is resolved separately (ADR-028).
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?     @relation("SaleCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelReason      String?

  originalSaleId  String?
  originalSale    Sale?   @relation("SaleCorrection", fields: [originalSaleId], references: [id])
  correctionSales Sale[]  @relation("SaleCorrection")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String
  createdBy       User     @relation("SaleCreatedBy", fields: [createdByUserId], references: [id])

  items                     SaleItem[]
  cashTransactions          CashTransaction[]
  productQuantityHistory    ProductQuantityHistory[]
  partnerDebtMovements      BusinessPartnerDebtMovement[]

  @@index([partnerId, businessDate])
  @@index([status])
}

/// Source: docs/business/invariants.md, "Products" — "each posted document
/// line keeps its own price and cost as recorded at posting time, regardless
/// of later master-data changes."
model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  unitId    String
  unit      Unit    @relation(fields: [unitId], references: [id])

  quantity       Decimal
  unitPrice      Decimal
  discountAmount Decimal?
  lineTotal      Decimal
  /// Source: docs/business/invariants.md, "Costing" — "A sale's cost is
  /// recorded (snapshotted) at the cost applicable at the time of posting;
  /// this snapshot does not change afterward even if the product's cost
  /// later changes." Nullable because a draft line has no posting-time cost
  /// yet.
  costAtPosting  Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------

/// Source: docs/business/invariants.md, "Purchasing"; docs/business/workflow-map.md,
/// "5. Purchase: Draft to Posted Purchase".
/// Document numbers are backend-allocated via NumberSequence key PURCHASE
/// (Approved Human Decision for EPIC-009 / US-022, 2026-07-31) as `PUR-` +
/// zero-padded sequence (ADR-024 allocation pattern; document numbers were
/// excluded from ADR-024 scope itself).
/// Status lifecycle: DRAFT → POSTED → CANCELLED (DocumentStatus). UI may say
/// "completed" for POSTED; API/schema use POSTED.
model Purchase {
  id                    String          @id @default(uuid())
  documentNumber        String          @unique
  partnerId             String
  partner               BusinessPartner @relation(fields: [partnerId], references: [id])
  businessDate          DateTime
  status                DocumentStatus  @default(DRAFT)

  supplierInvoiceNumber String?

  /// Amounts are static AZN (ADR-031). Scale: ADR-023 → Decimal(18, 4).
  /// Backend recalculates; client-supplied totals are ignored.
  subtotalAmount Decimal  @db.Decimal(18, 4)
  discountAmount Decimal? @db.Decimal(18, 4)
  totalAmount    Decimal  @db.Decimal(18, 4)
  notes          String?

  postedAt       DateTime?
  postedByUserId String?
  postedBy       User?     @relation("PurchasePostedBy", fields: [postedByUserId], references: [id])

  /// Cancelling reverses product-quantity and partner-debt effects (ADR-029 /
  /// ADR-030). Cash resolved separately (ADR-028).
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?     @relation("PurchaseCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelReason      String?

  originalPurchaseId  String?
  originalPurchase    Purchase?  @relation("PurchaseCorrection", fields: [originalPurchaseId], references: [id])
  correctionPurchases Purchase[] @relation("PurchaseCorrection")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String
  createdBy       User     @relation("PurchaseCreatedBy", fields: [createdByUserId], references: [id])

  items                     PurchaseItem[]
  cashTransactions          CashTransaction[]
  productQuantityHistory    ProductQuantityHistory[]
  partnerDebtMovements      BusinessPartnerDebtMovement[]

  @@index([partnerId, businessDate])
  @@index([status])
  @@index([supplierInvoiceNumber])
  @@index([createdByUserId])
  @@index([createdAt])
}

/// Source: docs/business/invariants.md, "Purchasing" — "A purchase is posted
/// based on the quantity actually physically received, not the invoiced
/// quantity; differences between the two are recorded separately."
/// Product/unit display fields are snapshotted so historical lines stay stable
/// when master data changes later.
model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  productCodeSnapshot String
  productNameSnapshot String
  unitNameSnapshot    String

  /// Physically received quantity (posting driver). Scale ADR-023.
  receivedQuantity Decimal  @db.Decimal(18, 4)
  invoicedQuantity Decimal? @db.Decimal(18, 4)
  /// Unit price/cost at line entry (AZN). Scale ADR-023 unit prices.
  unitCost         Decimal  @db.Decimal(18, 4)
  discountAmount   Decimal? @db.Decimal(18, 4)
  /// quantity × unitCost before line discount.
  lineSubtotal     Decimal  @db.Decimal(18, 4)
  lineTotal        Decimal  @db.Decimal(18, 4)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Cash
// ---------------------------------------------------------------------------

/// Source: docs/business/invariants.md, "Cash" — "The main cash account,
/// bank account, vehicle cash accounts, and personal funds are separate."
model MoneyAccount {
  id         String           @id @default(uuid())
  name       String
  type       MoneyAccountType
  /// Current release: all money is AZN (ADR-031). Multi-currency cash
  /// accounts are a future Cash-domain extension — not modeled here (YAGNI).
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  cashTransactions CashTransaction[] @relation("CashTransactionAccount")

  @@index([type])
  @@index([isActive])
}

/// Source: docs/business/invariants.md, "Cash" — "Every money movement
/// identifies the account, amount, date, movement type, actor, and business
/// reason or source." `amount` is signed (positive = increase, negative =
/// decrease) at the account identified by `moneyAccountId`. Amounts are AZN
/// (ADR-031). Optional links to Sale/Purchase remain (ADR-028).
model CashTransaction {
  id                    String              @id @default(uuid())
  moneyAccountId        String
  moneyAccount          MoneyAccount        @relation("CashTransactionAccount", fields: [moneyAccountId], references: [id])
  type                  CashTransactionType
  amount                Decimal
  transactionDate       DateTime
  reason                String?

  partnerId String?
  partner   BusinessPartner? @relation(fields: [partnerId], references: [id])

  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  pairedTransactionId String?          @unique
  pairedTransaction   CashTransaction? @relation("CashTransactionPair", fields: [pairedTransactionId], references: [id])
  pairedWith          CashTransaction? @relation("CashTransactionPair")

  status DocumentStatus @default(DRAFT)

  postedAt       DateTime?
  postedByUserId String?
  postedBy       User?     @relation("CashTransactionPostedBy", fields: [postedByUserId], references: [id])

  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?     @relation("CashTransactionCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelReason      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String
  createdBy       User     @relation("CashTransactionCreatedBy", fields: [createdByUserId], references: [id])

  partnerDebtMovements BusinessPartnerDebtMovement[]

  @@index([moneyAccountId, transactionDate])
  @@index([type])
  @@index([status])
  @@index([partnerId])
  @@index([saleId])
  @@index([purchaseId])
}
