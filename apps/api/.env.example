# Template only. Copy to .env and fill in real values locally; .env is git-ignored.
# See docs/decisions/ADR-014-prisma-orm.md and docs/decisions/ADR-008-postgresql-primary-database.md.
# Validated at startup by src/config/env.validation.ts.

DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Force Node/pg to treat TIMESTAMP WITHOUT TIME ZONE as UTC (matches Prisma writes).
# Without this, Asia/Baku host TZ shifts every read by −4 hours.
TZ=UTC

# development | test | production
NODE_ENV=development

PORT=3000

# Global REST API prefix (see docs/decisions/ADR-015-rest-openapi.md).
API_PREFIX=api

# Comma-separated list of allowed CORS origins.
# Local Vite defaults apply automatically in NODE_ENV=development when empty
# (http://localhost:5173 and http://127.0.0.1:5173).
# Production must set this explicitly; empty disables cross-origin requests.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional bootstrap first user when User table is empty (`yarn workspace api prisma:seed`).
# Omit or leave blank to skip. Password must be at least 8 characters when set.
# ADR-025: no roles — this is only the first equal active user (not a privileged type).
# BOOTSTRAP_USERNAME=superadmin
# BOOTSTRAP_PASSWORD=ChangeMe123!
# BOOTSTRAP_FULL_NAME=Super Admin

# JWT auth (ADR-025). Override secrets outside local development.
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
